{
  "name": "@ziptied/image-crop-upload",
  "version": "1.0.0",
  "description": "React image cropper — pan, zoom, rotate, flip, ratio and avatar crop shapes, WebP export",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.8",
  "license": "MIT",
  "author": "ziptied",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptied/image-cropper-uploader.git"
  },
  "bugs": {
    "url": "https://github.com/ziptied/image-cropper-uploader/issues"
  },
  "homepage": "https://github.com/ziptied/image-cropper-uploader#readme",
  "keywords": [
    "react",
    "crop",
    "cropper",
    "image",
    "avatar",
    "webp",
    "canvas",
    "rotate",
    "flip"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite --config examples/vite.config.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run validate",
    "pack:dry": "npm pack --dry-run",
    "validate": "bun run typecheck && bun run test && bun run lint && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "files": ["dist", "README.md", "MIGRATION.md", "ARCHITECTURE.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
