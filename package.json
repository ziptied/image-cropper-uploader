{
  "name": "@ziptied/image-crop-upload",
  "version": "0.2.1",
  "description": "Reusable image cropper with pan, zoom, rotation, and WebP export for React + Inertia",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "ziptied",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptied/image-cropper-uploader.git"
  },
  "bugs": {
    "url": "https://github.com/ziptied/image-cropper-uploader/issues"
  },
  "homepage": "https://github.com/ziptied/image-cropper-uploader#readme",
  "keywords": ["react", "inertia", "shadcn", "crop", "image", "webp", "canvas"],
  "scripts": {
    "build": "tsup",
    "prepack": "bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@biomejs/biome": "^1.9.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
